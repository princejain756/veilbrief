{
  "manifest_version": 3,
  "name": "VeilBrief Hybrid AI Shield",
  "description": "Shield PII locally, audit contracts offline or in cloud, verify wire SHA-256, and apply redlines inline.",
  "version": "0.2.0",
  "permissions": ["sidePanel", "contextMenus", "activeTab", "storage", "scripting"],
  "host_permissions": ["https://veilbrief.prince.sh/*", "http://localhost/*"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
