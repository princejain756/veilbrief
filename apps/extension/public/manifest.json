{
  "manifest_version": 3,
  "name": "VeilBrief Hybrid AI Shield",
  "description": "Audit selected text with local PII redaction before any model call.",
  "version": "0.1.0",
  "permissions": ["sidePanel", "contextMenus", "activeTab", "storage"],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
